# ══════════════════════════════════════
# SKONGA AI BACKEND — Environment Variables
# Copy this file as .env then fill in your keys
# ══════════════════════════════════════

PORT=3000
NODE_ENV=development

# ── AI Provider Keys ──
GROQ_API_KEY=
OPENROUTER_API_KEY=
AIMLAPI_KEY=
BAZAARLINK_API_KEY=
TAVILY_API_KEY=
# Gemini (Google AI Studio) — FREE, no payment card needed.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Override the AIMLAPI image-generation model if "flux/schnell" isn't
#    available on your account (check the model list on the AIMLAPI dashboard) ──
AIMLAPI_IMAGE_MODEL=

# ── Override the Gemini image-generation model (optional).
#    IMPORTANT: use the API model ID (e.g. gemini-2.5-flash-image),
#    NOT the display name shown in the AI Studio UI (e.g. "Gemini 3.1
#    Flash Lite Image" is a display name and will NOT work here). ──
GEMINI_IMAGE_MODEL=

# ── Pollinations.ai — FREE image generation, NO KEY REQUIRED for basic use.
#    Optional: register a free account (no payment card) at pollinations.ai
#    to raise the rate limit and remove the watermark, then paste the key here.
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=

# ── Default provider order for "auto" mode (comma separated, no spaces) ──
PROVIDER_FALLBACK_ORDER=groq,openrouter,aimlapi,pollinations,bazaarlink,gemini

# ── Rate limiting ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# ── Retry logic ──
PROVIDER_MAX_RETRIES=1
PROVIDER_TIMEOUT_MS=25000

# ── OpenRouter recommends setting site info (not required but recommended) ──
OPENROUTER_SITE_URL=https://skonga.ai
OPENROUTER_SITE_NAME=SKONGA AI

# ── SKONGA Library API (curriculum RAG — internal only) ──
# Deploy skonga-library-api first, then fill these in.
# The mobile app never calls the Library API; only this backend does.
LIBRARY_ENABLED=false
LIBRARY_API_URL=https://skonga-service-api.onrender.com
LIBRARY_SERVICE_TOKEN=
LIBRARY_TIMEOUT_MS=5000

# ── Mobile money / Pro payments (SECURITY) ─────────────────────────────
# SKONGA never collects M-Pesa/Tigo/Airtel/Halo PIN. STK runs on the phone.
# sandbox = test orders + POST /api/payments/sandbox-confirm
# live    = requires a real PSP (Selcom, AzamPay, etc.) + webhook secret
PAYMENT_MODE=sandbox
PAYMENT_PROVIDER=sandbox
# Long random secret for webhook HMAC (openssl rand -hex 32)
PAYMENT_WEBHOOK_SECRET=
