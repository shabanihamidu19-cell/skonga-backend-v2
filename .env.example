# ══════════════════════════════════════
# SKONGA AI BACKEND — Environment Variables
# ══════════════════════════════════════

PORT=3000
NODE_ENV=development

# ── AI Provider Keys ──
GROQ_API_KEY=
OPENROUTER_API_KEY=
AIMLAPI_KEY=
BAZAARLINK_API_KEY=
TAVILY_API_KEY=
GEMINI_API_KEY=
AIMLAPI_IMAGE_MODEL=
GEMINI_IMAGE_MODEL=
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=
PROVIDER_FALLBACK_ORDER=groq,openrouter,aimlapi,pollinations,bazaarlink,gemini

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
PROVIDER_MAX_RETRIES=1
PROVIDER_TIMEOUT_MS=25000
OPENROUTER_SITE_URL=https://skonga.ai
OPENROUTER_SITE_NAME=SKONGA AI

# ── SKONGA Library API (curriculum RAG) ──
LIBRARY_ENABLED=false
LIBRARY_API_URL=https://skonga-service-api.onrender.com
LIBRARY_SERVICE_TOKEN=
LIBRARY_TIMEOUT_MS=5000

# ── Auth-content usage quotas (server-to-server) ──
# Deploy skonga-auth-content-service first.
# USAGE_SERVICE_TOKEN must match SERVICE_TOKEN on auth-content.
USAGE_ENABLED=false
USAGE_API_URL=https://your-auth-content.onrender.com
USAGE_SERVICE_TOKEN=
USAGE_TIMEOUT_MS=4000

# ── Mobile money / Pro payments ──
PAYMENT_MODE=sandbox
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=
